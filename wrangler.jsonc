// Cloudflare settings for the Sound Street website.
{
  "name": "soundstreet",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    // Show our own 404 page for links that don't exist
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false
}
